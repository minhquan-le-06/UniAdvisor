# Not part of the deployed function. Every line starts with / so it names a folder at the top of the repository only:
# a bare `data` would also drop src/uniadvisor/data (the package's own code) and crash the function at import.
/.git
/.claude
/.venv
/data
/docs
/tests
/pipelines
/tools
/deploy
/web/node_modules
/.pytest_cache
**/__pycache__
**/*.pyc
*.db
.env
